# =====================================================
# 백엔드 운영 환경변수 — 서버의 /etc/coolingverse/backend.env 로 복사해 값 채우기
# ⚠️ 이 example 파일에는 실제 값을 절대 넣지 말 것 (저장소에 올라가는 파일임)
# 서버에서: sudo mkdir -p /etc/coolingverse && sudo nano /etc/coolingverse/backend.env
# 권한 잠금: sudo chmod 600 /etc/coolingverse/backend.env
# =====================================================

# 운영용 관리자 계정 (팀 결정 후 기입 — 로컬 테스트 계정 재사용 금지)
ADMIN_ID=운영용아이디
# BCrypt 해시 (원문 비밀번호 아님!). 해시 생성은 docs/DEPLOY.md 참고
ADMIN_PASSWORD_HASH=여기에BCrypt해시

# Oracle ADB 접속
ADB_PASSWORD=ADB의ADMIN비밀번호
# 서버에 업로드한 Wallet 폴더의 절대 경로 (리눅스 경로)
ADB_WALLET_DIR=/home/ubuntu/wallet
# 서비스명은 기본값(cvadb_tp) 사용 시 생략 가능
# ADB_SERVICE_NAME=cvadb_tp
