# =====================================================
# systemd 서비스 정의 — 서버 재부팅 시 백엔드 자동 시작 + 죽으면 자동 재시작
# 설치: sudo cp coolingverse-backend.service /etc/systemd/system/
#       sudo systemctl daemon-reload
#       sudo systemctl enable --now coolingverse-backend
# 로그: sudo journalctl -u coolingverse-backend -f
# =====================================================
[Unit]
Description=CoolingVerse Backend (Spring Boot)
# 네트워크가 준비된 뒤에 시작
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/app
# 환경변수는 파일로 주입 (backend.env.example 참고)
EnvironmentFile=/etc/coolingverse/backend.env
EnvironmentFile=/etc/coolingverse/admin.env
ExecStart=/usr/bin/java -jar /home/ubuntu/app/parking-auth.jar --spring.profiles.active=oracle
# 앱이 죽으면 5초 후 자동 재시작
Restart=on-failure
RestartSec=5
# 종료 시 정리 시간
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
